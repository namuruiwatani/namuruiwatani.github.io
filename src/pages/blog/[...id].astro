---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}
const { post, newer, older } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const { Content } = await render(post);
const minutes = Math.max(1, Math.round((post.body ?? '').split(/\s+/).length / 180));
const date = post.data.date.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={post.data.title} description={post.data.description}>
  <a class="back" href={base}>← Все записи</a>
  <article>
    <h1>{post.data.title}</h1>
    <div class="meta"><span class="tag">{post.data.type}</span>{date} · {minutes} мин чтения</div>
    <div class="body"><Content /></div>
  </article>
  <div class="end">
    {older ? <a href={`${base}blog/${older.id}/`}>← {older.data.title}</a> : <span></span>}
    {newer && <a href={`${base}blog/${newer.id}/`}>{newer.data.title} →</a>}
  </div>
  <script>import '../../scripts/karaoke.js';</script>
</Base>
